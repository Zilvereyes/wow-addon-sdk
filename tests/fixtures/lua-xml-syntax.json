    { "id": "L21-local-attribute", "source": "local x <const> = 1", "syntax": "invalid" },
    { "id": "L22-nested-varargs", "source": "function f(...) local function g() return ... end end", "syntax": "invalid" },
    { "id": "L23-break-outside-loop", "source": "break", "syntax": "invalid" },
    { "id": "L24-statement-after-return", "source": "return 1; Global = 2", "syntax": "invalid" }

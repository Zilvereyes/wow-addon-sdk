  "lua": [
    { "id": "L01-assignment", "source": "Global = 1", "syntax": "valid" },
    { "id": "L02-varargs", "source": "local a, b = ...; a, b = b, a; return a, b", "syntax": "valid" },
    { "id": "L03-long-brackets", "source": "--[==[ Fake = 1; ]=] still a comment ]==]\nlocal text = [=[x = 2; [[inner]]]=]\nReal = 3", "syntax": "valid" },
    { "id": "L04-short-strings", "source": "local a = '\\000\\255'; local b = \"quoted\"; Real = a .. b", "syntax": "valid" },

    ] },
    { "id": "L11-goto-identifier", "source": "goto = 1; return goto", "syntax": "valid" },
    { "id": "L12-empty", "source": "", "syntax": "valid" },
    { "id": "L13-no-execution", "source": "error('FIXTURE_MUST_ONLY_BE_PARSED'); return 1", "syntax": "valid" },
    { "id": "L14-unclosed-string", "source": "local text = 'unfinished", "syntax": "invalid" },
    { "id": "L15-unclosed-long-string", "source": "local text = [=[ unfinished ]]", "syntax": "invalid" },

    { "id": "L06-tables", "source": "local key = 'k'; Global = { [key] = 1; named = 2, 3, 4; }", "syntax": "valid" },
    { "id": "L07-operators", "source": "Global = -2^2 + #('x') * .5e+2; Hex = 0x1a; Text = 1 .. 'x'", "syntax": "valid" },
    { "id": "L08-blocks", "source": "for i = 1, 3 do if i == 2 then break end end\nfor k, v in pairs({}) do Global = v end\nlocal n = 1; while n > 0 do n = n - 1 end\nrepeat n = n + 1 until n >= 1", "syntax": "valid" },
    { "id": "L09-functions", "source": "local function f(n) if n == 0 then return 1 end return n * f(n - 1) end\nlocal t = {}; function t:m(a) return self, a end\nGlobal = f(3)", "syntax": "valid" },
    { "id": "L10-unicode-lines", "source": "-- 🧪\r\nGlobal = \"Å\"\rNext = 2\n", "syntax": "valid", "spans": [

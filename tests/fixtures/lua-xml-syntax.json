    { "id": "X23-default-namespace-attribute", "source": "<Ui xmlns=\"urn:fixture\" xmlns:p=\"urn:fixture\" a=\"1\" p:a=\"2\"/>", "wellFormed": true, "namespaceWellFormed": true, "profile": "allowed" },
    { "id": "X24-reserved-prefix", "source": "<Ui xmlns:xml=\"urn:wrong\"/>", "wellFormed": true, "namespaceWellFormed": false, "profile": "allowed" },
